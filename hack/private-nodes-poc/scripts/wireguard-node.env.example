# Example config for scripts/configure-wireguard.sh.
# Copy to a private file, fill values, chmod 0600, and do not commit/paste it.

CLUSTER_CIDR='10.244.0.0/16'

# Local node WireGuard address.
WG_ADDRESS='10.250.0.1/30'
WG_LISTEN_PORT='51820'
WG_MTU='1380'

# Generate on the node with:
#   umask 077
#   wg genkey | tee /root/wg-private.key | wg pubkey > /root/wg-public.key
WG_PRIVATE_KEY='REDACTED'

# Peer public key and public endpoint.
WG_PEER_PUBLIC_KEY='REDACTED'
WG_PEER_ENDPOINT='<peer-public-ip>:51820'

# Include the peer WG IP and the peer Kubernetes PodCIDR.
WG_ALLOWED_IPS='10.250.0.2/32,<peer-pod-cidr>'
