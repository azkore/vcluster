# Example config for scripts/bootstrap-private-node.sh.
# Copy to a private file, fill values, chmod 0600, and do not commit/paste it.

NODE_NAME='node-a'
NODE_IP='<node-advertise-ip>'

# Usually sourced from the env file generated by mint-node-secrets.sh.
VCLUSTER_ENDPOINT='<vcluster-api-host>:443'
VCLUSTER_CA_B64='REDACTED'
KUBEADM_TOKEN='REDACTED'
KUBE_PROXY_TOKEN='REDACTED'
KONNECTIVITY_TOKEN='REDACTED'

# Copy this bundle to the VM, or provide NODE_BUNDLE_URL.
NODE_BUNDLE='/root/vcluster-node-bundle-v1.35.0.tgz'
# NODE_BUNDLE_URL='https://example.invalid/vcluster-node-bundle-v1.35.0.tgz'

# Optional: set if you already know the assigned PodCIDR, otherwise the script
# waits for vCluster to assign one after kubeadm join.
# POD_CIDR='10.244.1.0/24'

CLUSTER_CIDR='10.244.0.0/16'
CLUSTER_DNS='10.96.0.10'
KONNECTIVITY_SERVER_PORT='8091'
KONNECTIVITY_AGENT_IDENTIFIERS='host=node-a&ipv4=<node-advertise-ip>'

# Optional WireGuard dataplane. Set true and fill all fields for cross-provider
# PodCIDR routing.
WG_ENABLE='false'
WG_ADDRESS='10.250.0.1/30'
WG_PRIVATE_KEY='REDACTED'
WG_PEER_PUBLIC_KEY='REDACTED'
WG_PEER_ENDPOINT='<peer-public-ip>:51820'
WG_ALLOWED_IPS='10.250.0.2/32,<peer-pod-cidr>'
WG_LISTEN_PORT='51820'
WG_MTU='1380'
